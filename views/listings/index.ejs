<% layout("/layouts/boilerplate.ejs") -%>
<body>
    <br>
    <div class="row row-cols-lg-3 row-cols-md-2 row-clos-sm-1">
    <% for(let listing of allListing) { %>
        <a href="/listing/<%=listing._id%>" class="listing-link">
        <div class="card col listing-card" style="width: 23rem;">
            <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image" style="height: 20rem;">
            <div class="card-body">
              <p class="card-text">
                <%=listing.title%> <br>
                &#8377; <%= listing.price%>
            </p>
            </div>
          </div>
        </a>  
    <% } %>
    </div>

    <!-- <ul>
    <% for(let listing of allListing) { %>
        <a href="/listing/<%=listing._id%>"><li><%= listing.title %></li></a>
    <% } %>
    </ul> -->
</body>
